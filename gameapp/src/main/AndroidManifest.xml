<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.poolvulkan">

    <uses-feature android:name="android.hardware.vulkan.level" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="true"/>
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false"/>

    <application
        android:label="Pool Vulkan"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name="android.app.NativeActivity"
            android:label="Pool Vulkan"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="poolvulkan" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
